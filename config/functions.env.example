# Copy to .env.functions.local (ignored). Never use Flutter dart-defines for these.
# Requires an operator-confirmed Gemini Free Tier project with billing disabled.
# Code cannot determine billing tier from an API key. Do not enable paid fallback.
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=false
# Explicit, reviewed grammar UUID allowlist. Draft fixtures are not auto-approved.
BUNLY_APPROVED_GRAMMAR_IDS=[]
